{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=bookings_db;Username=postgres;Password=postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otlp": {
    "Endpoint": "http://localhost:4317",
    "ServiceName": "bookings-service"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Jwt": {
    "Secret": "EventManager-Jwt-Signing-Key-32ch!",
    "Issuer": "EventManager",
    "Audience": "EventManager"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  }
}
